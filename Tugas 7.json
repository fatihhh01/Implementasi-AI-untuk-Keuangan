    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nconst now = new Date();\nconst end = new Date(now);\nend.setHours(23, 59, 59, 999);\n\nconst start = new Date(now);\nstart.setDate(start.getDate() - 6);\nstart.setHours(0, 0, 0, 0);\n\nconst expenses = items\n  .map(item => item.json)\n  .filter(row => {\n    const parts = String(row.Tanggal || '').split('/');\n    if (parts.length !== 3) return false;\n\n    const [day, month, year] = parts.map(Number);\n    const date = new Date(year, month - 1, day);\n\n    return date >= start && date <= end;\n  });\n\nconst formatRupiah = value =>\n  Number(String(value || 0).replace(/\\D/g, ''))\n    .toLocaleString('id-ID');\n\nconst laporan = expenses.length\n  ? expenses.map((row, i) =>\n      `${i + 1}. Tanggal: ${row.Tanggal}\\n` +\n      `Kategori: ${row.Kategori}\\n` +\n      `Deskripsi: ${row.Deskripsi}\\n` +\n      `Metode Pembayaran: ${row['Metode Pembayaran']}\\n` +\n      `Jumlah: Rp${formatRupiah(row['Jumlah (IDR)'])}\\n` +\n      `Penerima: ${row.Penerima}`\n    ).join('\\n\\n')\n  : 'Tidak ada pengeluaran dalam 7 hari terakhir.';\n\nreturn [{\n  json: {\n    hasExpenses: expenses.length > 0,\n    jumlahTransaksi: expenses.length,\n    laporanPengeluaran: laporan\n  }\n}];\n"
      },
